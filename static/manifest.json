{
	"name": "AnkiFlash Generator",
	"description": "A tool generates flash-cards for importing into Anki memorizing app (https://apps.ankiweb.net)",
	"version": "1.1.0",
	"manifest_version": 3,
	"homepage_url": "https://longly.info",
	"author": "hoanglongtc7@gmail.com",
	"minimum_chrome_version": "110",
	"background": {
		"service_worker": "bundle/background.bundle.js",
		"type": "module"
	},
	"options_page": "static/html/options.html",
	"permissions": [
		"tabs",
		"storage",
		"downloads",
		"contextMenus",
		"unlimitedStorage"
	],
	"host_permissions": [
		"https://www.oxfordlearnersdictionaries.com/*",
		"https://tratu.coviet.vn/*",
		"https://dictionary.cambridge.org/*",
		"https://www.collinsdictionary.com/*",
		"https://kantan.vn/*",
		"https://jisho.org/*",
		"https://localhost/*",
		"https://127.0.0.1/*"
	],
	"action": {
		"default_icon": {
			"16": "static/img/favicon16.png",
			"32": "static/img/favicon32.png",
			"48": "static/img/favicon48.png",
			"128": "static/img/favicon128.png"
		},
		"default_title": "AnkiFlash Generator"
	},
	"icons": {
		"16": "static/img/favicon16.png",
		"32": "static/img/favicon32.png",
		"48": "static/img/favicon48.png",
		"128": "static/img/favicon128.png"
	}
}
